<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <!-- Run on a newer .NET too if 10 is not installed (the installer accepts 10 or newer). -->
    <RollForward>LatestMajor</RollForward>

    <!-- A tray app that mostly sleeps never benefits from profile-guided re-optimization;
         measured, turning it off saves about 4 MB of memory once the popup has been used. -->
    <TieredPGO>false</TieredPGO>

    <!-- The icon of the exe (Explorer, the taskbar, Task Manager). -->
    <ApplicationIcon>Assets\RazerHelper.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same icon, inside the exe, for the tray. -->
    <EmbeddedResource Include="Assets\RazerHelper.ico" LogicalName="RazerHelper.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core types are internal; the test project needs to see them. -->
    <InternalsVisibleTo Include="RazerHelper.Tests" />
  </ItemGroup>

</Project>
